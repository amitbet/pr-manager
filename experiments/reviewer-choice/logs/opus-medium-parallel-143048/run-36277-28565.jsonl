ached by the client) shouldn't stop the item from being tracked.\n84\t\t\tmd.record, _ = getRecord(it.ID)\n85\t\t\treturn md, nil\n86\t\tcase KindBlob, KindLink:\n87\t\tdefault:\n88\t\t\treturn &Metadata{}, nil\n89\t\t}\n90\t\tblob := blobID(it.ID)\n91\t\tif blob == \"\" {\n92\t\t\treturn nil, errNoBlob\n93\t\t}\n94\t\treturn &Metadata{blobID: blob, labels: parseLabels(it.ID)}, nil\n95\t}\n96\t\n97\tfunc blobID(id string) string {\n98\t\ti := strings.LastIndex(id, \"@\")\n99\t\tif i < 0 {\n100\t\t\treturn \"\"\n101\t\t}\n102\t\treturn id[i+1:]\n103\t}\n104\t\n105\tfunc parseLabels(id string) map[string]string {\n106\t\tres := map[string]string{}\n107\t\tq := strings.Index(id, \"?\")\n108\t\tif q < 0 {\n109\t\t\treturn res\n110\t\t}\n111\t\tfor _, kv := range strings.Split(id[q+1:], \"&\") {\n112\t\t\tk, v, _ := strings.Cut(kv, \"=\")\n113\t\t\tres[k] = v\n114\t\t}\n115\t\treturn res\n116\t}\n117\t"}]},"parent_tool_use_id":null,"session_id":"41d61078-e683-48c5-a128-529d88f26c3c","uuid":"04eabbc7-f872-4d5d-a465-3472ff98ebeb","timestamp":"2026-10-04T11:31:17.927Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/amit.bezalel/workspace/pr-triage/testdata/eval/inventory-error-cache.head/store/loader.go","content":"package store\n\nimport (\n\t\"errors\"\n\t\"sort\"\n\t\"strings\"\n\t\"sync\"\n)\n\ntype Kind int\n\nconst (\n\tKindUnknown Kind = iota\n\tKindRecord\n\tKindBlob\n\tKindLink\n)\n\n// Item is one entry the loader tracks.\ntype Item struct {\n\tID    string\n\tKind  Kind\n\tOwner string\n}\n\n// Metadata is what the loader knows about an item beyond its ID.\ntype Metadata struct {\n\trecord Record\n\tlabels map[string]string\n\tblobID string\n}\n\ntype Loader struct {\n\tmu    sync.Mutex\n\titems map[string]*Item\n\tmeta  map[string]*Metadata\n}\n\nfunc NewLoader() *Loader {\n\treturn &Loader{items: map[string]*Item{}, meta: map[string]*Metadata{}}\n}\n\nvar errNoBlob = errors.New(\"item has no blob id\")\n\nfunc (l *Loader) Track(it *Item) error {\n\tmd, err := loadMetadata(it)\n\tif err != nil {\n\t\treturn err\n\t}\n\tl.mu.Lock()\n\tdefer l.mu.Unlock()\n\tl.items[it.ID] = it\n\tl.meta[it.ID] = md\n\tif md.record.Owner != \"\" {\n\t\tit.Owner = md.record.Owner\n\t}\n\treturn nil\n}\n\nfunc (l *Loader) Forget(id string) {\n\tl.mu.Lock()\n\tdefer l.mu.Unlock()\n\tdelete(l.items, id)\n\tdelete(l.meta, id)\n}\n\nfunc (l *Loader) IDs() []string {\n\tl.mu.Lock()\n\tdefer l.mu.Unlock()\n\tids := make([]string, 0, len(l.items))\n\tfor id := range l.items {\n\t\tids = append(ids, id)\n\t}\n\tsort.Strings(ids)\n\treturn ids\n}\n\nfunc loadMetadata(it *Item) (*Metadata, error) {\n\tswitch it.Kind {\n\tcase KindRecord:\n\t\tmd := &Metadata{}\n\t\t// The record only refines who owns the item, so a failed lookup (logged\n\t\t// and cached by the client) shouldn't stop the item from being tracked.\n\t\tmd.record, _ = getRecord(it.ID)\n\t\treturn md, nil\n\tcase KindBlob, KindLink:\n\tdefault:\n\t\treturn &Metadata{}, nil\n\t}\n\tblob := blobID(it.ID)\n\tif blob == \"\" {\n\t\treturn nil, errNoBlob\n\t}\n\treturn &Metadata{blobID: blob, labels: parseLabels(it.ID)}, nil\n}\n\nfunc blobID(id string) string {\n\ti := strings.LastIndex(id, \"@\")\n\tif i < 0 {\n\t\treturn \"\"\n\t}\n\treturn id[i+1:]\n}\n\nfunc parseLabels(id string) map[string]string {\n\tres := map[string]string{}\n\tq := strings.Index(id, \"?\")\n\tif q < 0 {\n\t\treturn res\n\t}\n\tfor _, kv := range strings.Split(id[q+1:], \"&\") {\n\t\tk, v, _ := strings.Cut(kv, \"=\")\n\t\tres[k] = v\n\t}\n\treturn res\n}\n","numLines":117,"startLine":1,"totalLines":117}}}
