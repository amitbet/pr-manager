/pr-manager
triage.json
triage.md
/.cache/

# never commit credentials
.env
.env.*
!.env.example
*.keys
*.keys.*
*.pem

# Release archives and generated package manifests
/dist/
/tests/ui/node_modules/
/tests/ui/test-results/
/tests/ui/playwright-report/

# Windows resources generated by scripts/build-desktop.sh
*.syso

# Experiment fixtures and model-response caches. Both are large (third-party
# sources, one JSON per LLM call) and reproducible: each experiment's
# fetch.py refetches its data, and the runners recreate the rest. The
# scripts, protocols, findings and summary metrics are committed.
/experiments/*/data/
/experiments/*/cache/
/experiments/*/results/jobs.json
/experiments/*/results/*.request.json
/experiments/*/results/[a-z]*-[0-9][0-9][0-9].json
